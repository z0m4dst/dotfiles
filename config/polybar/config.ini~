; =========================================================
; COLORS — paleta base
; =========================================================
[colors]
bg = #1e1e1e
fg = #c5c8c6
gray = #5c6370
cyan = #61afef
red = #a86c6c

; =========================================================
; BAR — Netbook (eDP-1)
; =========================================================
[bar/netbook]
monitor = eDP-1
width = 99%
height = 30
radius = 10

offset-x = 0.4%
offset-y = 5

background = ${colors.bg}
foreground = ${colors.fg}

border-size = 1
line-size = 1
line-color = #6f8f8f

padding-left = 1
padding-right = 1
module-margin = 4

font-0 = JetBrainsMono Nerd Font Mono:size=12;4

modules-left = bspwm
modules-center = core
modules-right = wlan date
enable-ipc = true

; =========================================================
; BAR — TV (HDMI-1) con fuentes más grandes
; =========================================================
[bar/tv]
monitor = HDMI-1
width = 99%
height = 45
radius = 10

offset-x = 0.4%
offset-y = 5

background = ${colors.bg}
foreground = ${colors.fg}

border-size = 1
line-size = 1
line-color = #6f8f8f

padding-left = 4
padding-right = 1
module-margin = 2

; Letras y altura de barra más grandes para la TV
font-0 = JetBrainsMono Nerd Font Mono:size=18;6

modules-left = bspwm
modules-center = core
modules-right = wlan date
enable-ipc = true

; =========================================================
; MÓDULOS (Mantén tus módulos idénticos abajo)
; =========================================================
[module/bspwm]
type = internal/bspwm
format = <label-state>
label-focused = "●"
label-focused-foreground = ${colors.cyan}
label-focused-margin = 1
label-occupied = "●"
label-occupied-foreground = ${colors.fg}
label-occupied-margin = 1
label-empty = "○"
label-empty-foreground = ${colors.gray}
label-empty-margin = 1

[module/core]
type = custom/text
format = <label>
label = z0m4{OS}
label-foreground = ${colors.cyan}
label-padding = 1
click-left = powermenu
click-right = rofi -show run

[module/date]
type = custom/script
interval = 10
exec = ~/.config/polybar/scripts/updates.sh

[module/wlan]
type = internal/network
interface = wlp3s0
interval = 3.0

; Acción al hacer clic izquierdo sobre el icono o texto del Wi-Fi
click-left = /usr/bin/wifi-menu

; Formato conectado: muestra el icono y la IP
format-connected = <ramp-signal> <label-connected>
label-connected = %local_ip%
label-connected-foreground = ${colors.cyan}

; Formato desconectado
format-disconnected = <label-disconnected>
label-disconnected = 󰤮 OFF
label-disconnected-foreground = ${colors.gray}

; Iconos de señal
ramp-signal-0 = 󰤯
ramp-signal-1 = 󰤟
ramp-signal-2 = 󰤢
ramp-signal-3 = 󰤥
ramp-signal-4 = 󰤨
ramp-signal-foreground = ${colors.cyan} 
