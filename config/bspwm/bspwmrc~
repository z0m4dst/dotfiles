#!/bin/bash

# =========================
# INPUT / KEYBOARD
# =========================

# Layout latino
setxkbmap latam &

# Mapear F1 → Escape
xmodmap -e "keycode 67 = Escape" &


# =========================
# CORE SERVICES
# =========================

# Keybindings
pkill -x sxhkd 2>/dev/null
 sxhkd &

# Compositor (transparencias + blur)
pkill -x picom 2>/dev/null
 picom &

# cpliz
pkill clipz 2>/dev/null
~/.local/bin/clipz daemon &
# =========================
# BSPWM BASE
# =========================

# Cursor (nivel X11, no GTK)
export XCURSOR_THEME="Bibata-Modern-Ice"
export XCURSOR_SIZE=24

xrdb -merge <<EOF
Xcursor.theme: Bibata-Modern-Ice
Xcursor.size: 24
EOF

xsetroot -cursor_name left_ptr

# Escritorios
if xrandr --query | grep -q "HDMI-1 connected"; then
    bspc monitor eDP-1 -d 1 2 3 4
    bspc monitor HDMI-1 -d 5 6 7 8
else
    bspc monitor eDP-1 -d 1 2 3 4
fi
# Sin bordes 
bspc config border_width 0

# Colores (reservados por si se usan bordes en el futuro)
bspc config normal_border_color "#1c1f26"
bspc config focused_border_color "#61afef"
bspc config active_border_color "#c678dd"
bspc config presel_feedback_color "#242830"
# Espaciado (define toda la estética)
bspc config window_gap 3
bspc config top_padding 30
bspc config bottom_padding 4
bspc config left_padding 4
bspc config right_padding 4

# Comportamiento
bspc config focus_follows_pointer true
bspc config pointer_follows_focus false


# =========================
# UI / VISUAL
# =========================

# Barra
pkill polybar 2>/dev/null
~/.config/polybar/launch.sh &

# Wallpaper
feh --bg-fill /home/z0m4/Img/eva01.png &


# =========================
# REGLAS (FUTURO / OPCIONAL)
# =========================

 Rofi centrado (activar si lo necesitas)
 bspc rule -a Rofi state=floating center=true
 bspc rule -a Rofi layer=normal
 bspc rule -a Rofi state=floating focus=off

# Ejemplos de apps flotantes
# bspc rule -a Pavucontrol state=floating center=true
# bspc rule -a Thunar state=floating

# Tamaño inicial de ventanas flotantes
 bspc rule -a \* state=floating rectangle=800x600+100+100
bspc rule -a Thunar:Thunar-preferences state=floating center=true
bspc rule -a Thunar:Thunar-file-chooser state=floating center=true
# Escritorios dinámicos para Netbook y TV
if xrandr --query | grep -q "HDMI-1 connected"; then
    bspc monitor eDP-1 -d 1 2
    bspc monitor HDMI-1 -d 3 4
else
    bspc monitor eDP-1 -d 1 2 3 4
fi
