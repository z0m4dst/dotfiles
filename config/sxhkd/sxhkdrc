# -------- CORE --------

# Clipboard (clipz)
ctrl + g
    bash -c 'DISPLAY=:0 ~/.local/bin/clipz menu'

# Terminal
ctrl + alt + Return
    ~/.local/bin/alacritty-toggle.sh


# -------- BSPWM --------

# Recargar bspwm
ctrl + alt + r
    bspc wm -r

# Navegación de ventanas
ctrl + alt + Left
    bspc node -f west

ctrl + alt + Right
    bspc node -f east

ctrl + alt + Up
    bspc node -f north

ctrl + alt + Down
    bspc node -f south


# -------- VENTANAS --------

# Cerrar ventana
ctrl + q
    bspc node -c

# Fullscreen
#ctrl + f
#    bspc node -t fullscreen

# Toggle flotante
ctrl + shift + space
    bspc node -t floating


# -------- PRESELECCIÓN --------

# Definir dónde abrir la próxima ventana
ctrl + shift + Down
    bspc node -p south

ctrl + shift + Up
    bspc node -p north

ctrl + shift + Left
    bspc node -p west

ctrl + shift + Right
    bspc node -p east

# Cancelar preselección
ctrl + shift + c
    bspc node -p cancel


# -------- SISTEMA --------

# Recargar sxhkd
ctrl + alt + s
    pkill -USR1 sxhkd
